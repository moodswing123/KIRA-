# ─────────────────────────────────────────────────────────────────────────────
# KIRA MD BOT SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
BOT_NAME=KIRA-MD
BOT_VERSION=1.0.0
BOT_PREFIX=.
BOT_MODE=public
BOT_DESCRIPTION=Advanced WhatsApp Bot by Victory Tech

# WhatsApp owner number: country code + number, digits only, no + sign
OWNER_NUMBER=
OWNER_NAME=Victory Tech

# ─────────────────────────────────────────────────────────────────────────────
# GPT / AI API KEYS
# Add only the providers you want to use. Never commit real keys to GitHub.
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Legacy alias accepted by the bot when OPENAI_API_KEY is not set
OPEN_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Optional Gemini model override; the bot has a built-in default
GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# DOWNLOAD / SEARCH API KEYS
# Most download commands also have public-service or local fallbacks.
# ZSTLAB_API_KEY enables the documented ZSTLAB search/download endpoints.
# ─────────────────────────────────────────────────────────────────────────────
ZSTLAB_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL IMAGE-PROCESSING API KEYS
# ─────────────────────────────────────────────────────────────────────────────
REMOVE_BG_API_KEY=
PHOTOROOM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL DASHBOARD SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
DASHBOARD_API_KEY=
DASHBOARD_PORT=3000

# Leave blank; pairing code is generated automatically
SESSION_ID=
