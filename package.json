{
  "name": "kira-md",
  "version": "1.0.0",
  "description": "Kira MD — Advanced WhatsApp Bot by Victory Tech",
  "main": "index.js",
  "scripts": {
    "prestart": "node -e \"try { require.resolve('dotenv'); } catch { console.error('Missing dependencies. Run: bash setup.sh'); process.exit(1); }\"",
    "start":   "node index.js",
    "dev":     "node index.js",
    "test:commands": "node scripts/command-system-test.js",
    "setup":   "bash setup.sh",
    "fresh":   "rm -rf node_modules package-lock.json && npm install --legacy-peer-deps --registry=https://registry.npmjs.org && node index.js"
  },
  "keywords": ["whatsapp", "bot", "kira-md", "victory-tech"],
  "author": "Victory Tech",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "@hapi/boom":              "^10.0.1",
    "axios":                   "^1.6.0",
    "openai":                  "^4.20.0",
    "@anthropic-ai/sdk":       "^0.20.0",
    "@google/generative-ai":   "^0.2.0",
    "dotenv":                  "^16.3.1",
    "pino":                    "^9.6.0",
    "pino-pretty":             "^13.0.0",
    "sharp":                   "^0.33.0",
    "fluent-ffmpeg":           "^2.1.2",
    "qrcode-terminal":         "^0.12.0",
    "node-cache":              "^5.1.2",
    "form-data":               "^4.0.0",
    "express":                 "^4.18.2",
    "socket.io":               "^4.6.0"
  }
}
